# ─────────────────────────────────────────────────────────────────────────────
# Scribe — environment configuration (Phase 0)
# Copy to `.env` and adjust. NEVER commit a real .env. The values below are safe
# development defaults; production MUST override every secret.
# ─────────────────────────────────────────────────────────────────────────────

# --- General ---
NODE_ENV=development

# --- PostgreSQL (consumed by the `db` service in docker-compose) ---
POSTGRES_USER=scribe
POSTGRES_PASSWORD=scribe_dev_password
POSTGRES_DB=scribe
POSTGRES_PORT=5432

# --- Backend ---
# Port the Fastify server listens on (inside the container and exposed to host).
PORT=4000
# Connection string used by the backend. Host `db` is the docker-compose service
# name; use `localhost` when running the server directly on the host.
DATABASE_URL=postgres://scribe:scribe_dev_password@db:5432/scribe

# JWT / auth secrets — CHANGE THESE IN PRODUCTION. Use long random strings.
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie configuration. In production set COOKIE_SECURE=true (served over HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma-separated list of allowed browser origins for CORS (the frontend). Also used
# as the Origin allow-list for the cookie-authenticated /api/auth/refresh in production.
CORS_ORIGINS=http://localhost:5173

# --- Abuse / durability limits (Phase 4) ---
# Max HTTP request body in bytes (over-limit → 413). Bodies are tiny; 64 KiB is ample.
MAX_HTTP_BODY_BYTES=65536
# Max single WebSocket frame in bytes (over-limit → socket closed with 1009). 1 MiB is
# far above a normal Yjs update / initial sync for MVP-sized documents.
MAX_WS_MESSAGE_BYTES=1048576
# Grace window (ms) treating a re-presented just-rotated refresh token as a benign
# concurrent refresh rather than theft. Keep small.
REFRESH_REUSE_GRACE_MS=10000
# Optional: force EVERY rate-limit ceiling to this value (leave unset for per-endpoint
# defaults). The in-memory limiter is single-instance; a horizontally-scaled deployment
# would need a shared store (e.g. Redis) — intentionally out of MVP scope.
# RATE_LIMIT_MAX=

# --- Media attachments (ADR 0012) ---
# Directory where uploaded image binaries are stored (created on boot). In docker this
# is a named volume mounted at /app/var/media so uploads persist and stay out of the
# repo. The binary NEVER goes into Yjs/Postgres — only its metadata + a UUID key do.
MEDIA_DIR=var/media
# Max accepted upload size in bytes (over-limit → 413). Validated server-side, and the
# multipart parser rejects larger files before buffering them. 5 MiB default.
MEDIA_MAX_BYTES=5242880

# --- Frontend (Vite) ---
# Base URL the browser uses to reach the API. In docker-compose dev the Vite
# server proxies /api, so this stays same-origin.
VITE_API_BASE_URL=/api
# Port the Vite dev server listens on.
WEB_PORT=5173
