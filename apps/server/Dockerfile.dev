# Development image for the Scribe backend. Build context is the repo ROOT so
# the pnpm workspace resolves. Dependencies are installed inside the image (with
# correct Linux native binaries, e.g. @node-rs/argon2); docker-compose uses named
# volumes to keep these node_modules from being shadowed by the source bind mount.
FROM node:22-slim

RUN corepack enable
WORKDIR /app

# Install workspace deps from manifests first for better layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile

# Source is bind-mounted in dev; copied here so the image also works standalone.
COPY . .

EXPOSE 4000
CMD ["pnpm", "--filter", "@scribe/server", "dev"]
