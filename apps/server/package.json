    "@node-rs/argon2": "^2.0.2",
    "@scribe/shared": "workspace:*",
    "@tiptap/core": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "y-prosemirror": "^1.2.15",
    "yjs": "^13.6.21",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^2.15.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
